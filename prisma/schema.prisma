generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Registrant {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  status    String   @default("Pending")
  timestamp DateTime @default(now())
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String
}
